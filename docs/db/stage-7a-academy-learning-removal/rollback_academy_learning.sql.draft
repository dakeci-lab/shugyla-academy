--   production (would overwrite working platform data).
--
-- Checksums: verify SHA256SUMS before any restore.
--
-- This file intentionally does not embed production row data.

-- Example (run on a workstation with network to production; never commit passwords):
--
--   export PGHOST=... PGPORT=5432 PGUSER=... PGDATABASE=postgres
--   read -s PGPASSWORD; export PGPASSWORD
--   shasum -a 256 -c ~/secure-backups/shugyla-platform/20260802T231625Z/SHA256SUMS
--   pg_restore --no-owner --no-privileges --role=postgres \
--     -d "$PGDATABASE" \
--     ~/secure-backups/shugyla-platform/20260802T231625Z/academy_learning_tables.pgdump
--   psql -v ON_ERROR_STOP=1 -f \
--     ~/secure-backups/shugyla-platform/20260802T231625Z/learning_permissions_restore.sql
--   # then count(*) checks from preflight.sql / manifest.json
--   unset PGPASSWORD
--
-- Do not recreate academy_users, Standards, or shared academy_set_updated_at()
-- unless they are actually missing (they must survive the DROP migration).
