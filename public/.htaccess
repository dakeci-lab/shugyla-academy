Options -MultiViews

RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.shugyla-market\.kz$ [NC]
RewriteRule ^ https://shugyla-market.kz%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

  <FilesMatch "^(index\.html|404\.html|sw\.js|manifest\.webmanifest|version\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  SetEnvIf Request_URI "^/assets/" shugyla_immutable
  Header set Cache-Control "public, max-age=31536000, immutable" env=shugyla_immutable
</IfModule>
